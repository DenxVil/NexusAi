# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
# Use either MONGO_URI or MONGODB_URI (both are supported for compatibility)
MONGO_URI=mongodb://localhost:27017/nexusai
MONGODB_URI=mongodb://localhost:27017/nexusai

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Client Configuration
# Set this to the frontend's API URL requirement in production
REACT_APP_API_URL=http://localhost:5000/api

# AI Service API Keys
# For optimal intelligence, configure all three providers:
# 1. Perplexity (Primary) - Real-time internet data and current information
# 2. Gemini (Secondary) - Advanced reasoning and comprehensive responses  
# 3. HuggingFace (Tertiary) - Fallback conversational AI
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# AI Configuration - Optimized for best intelligence
DEFAULT_AI_MODEL=perplexity
MAX_TOKENS_PER_REQUEST=2048
REQUEST_TIMEOUT_MS=45000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# Socket.io
SOCKET_IO_CORS_ORIGIN=http://localhost:3000